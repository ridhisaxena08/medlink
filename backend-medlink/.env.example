# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/medlink360

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:5000/api/files
MAX_UPLOAD_SIZE_MB=15

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Intelligence / external providers (optional - all have safe local fallbacks)
AI_PROVIDER=stub
AI_API_KEY=
OCR_PROVIDER=stub
OCR_API_KEY=
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=MEDLNK
TTS_PROVIDER=stub

# API docs (Swagger UI)
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs

# Offline data
OFFLINE_DATA_VERSION=1

# Access control
ASHA_DEFAULT_ACCESS_DAYS=90
CONSENT_DEFAULT_DAYS=180
